# Archivos y directorios a ignorar en el contexto de Docker

# Base de datos local
db.sqlite3
*.sqlite3

# Archivos de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Logs
*.log
logs/

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Media files (opcionales, dependiendo de si quieres incluir media en la imagen)
media/

# Static files compilados (se generan en el contenedor)
staticfiles/
static/

# Archivos de configuración local
.env
.env.local
.env.production

# Node modules (si usas frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage reports
htmlcov/
.coverage
.pytest_cache/

# Documentación
README.md
docs/

# Archivos de setup
setup.ps1
setup.sh
