# Archivos y directorios a ignorar en el contexto de Docker

# Base de datos local
**/*.sqlite3
**/db.sqlite3

# Archivos de Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
.Python
**/build/
**/develop-eggs/
**/dist/
**/downloads/
**/eggs/
**/.eggs/
**/lib/
**/lib64/
**/parts/
**/sdist/
**/var/
**/wheels/
**/*.egg-info/
**/.installed.cfg
**/*.egg
**/MANIFEST

# Logs
**/*.log
**/logs/

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# IDEs y editores
.vscode/
.idea/
**/*.swp
**/*.swo
**/*~

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Media files (opcionales)
**/media/

# Static files compilados
**/staticfiles/
**/static/

# Archivos de configuración local
.env
.env.local
.env.production

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage reports
**/htmlcov/
**/.coverage
**/.pytest_cache/

# Documentación
README.md
**/README*.md
**/docs/

# Archivos de setup locales
setup.ps1
setup.sh
**/setup.ps1
**/setup.sh

# Archivos de deployment
deploy.sh
deploy.bat
