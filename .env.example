# Environment variables for WPA Docker Compose
# Copy this file to .env and adjust values as needed

# Port configuration for Coolify/Production
# If port 8000 is already in use on your host, change these values
HOST_PORT=9000      # Port on the host machine (default: 9000)
CONTAINER_PORT=8000 # Port inside the container (default: 8000)
# Note: PORT variable is also supported for backward compatibility

# Django settings for Coolify/Production
DEBUG=False
ALLOWED_HOSTS=*
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@wpa.local
DJANGO_SUPERUSER_PASSWORD=admin1234

# CSRF and Security settings for Coolify
# Coolify will automatically set these:
# SERVICE_URL_WPA=https://your-domain.nubecreativa.site
# SERVICE_FQDN_WPA=your-domain.nubecreativa.site
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# Database configuration (optional)
# DATABASE_URL=postgres://user:password@host:port/database

# For Coolify deployment:
# 1. Create a .env file in your Coolify project with these variables
# 2. If port 8000 is already allocated, change HOST_PORT to a different port (e.g., 9000, 8080, 3000)
# 3. Set ALLOWED_HOSTS=* to allow access from any domain (Coolify will assign its own domain)
# 4. Coolify automatically sets SERVICE_URL_WPA and SERVICE_FQDN_WPA for CSRF protection
# 5. For production, security settings are enabled by default (CSRF_COOKIE_SECURE=True, etc.)
